WelcomeScreen {
    align: center middle;
}

#welcome-box {
    width: 50;
    height: 15;
    border: solid #00d4ff;
    background: #0a0e14;
    padding: 1 2;
}

#welcome-title {
    text-align: center;
    text-style: bold;
    color: #00d4ff;
    margin-bottom: 1;
}

#welcome-message {
    text-align: center;
    margin-bottom: 2;
}

Button {
    margin: 0 12;
}
